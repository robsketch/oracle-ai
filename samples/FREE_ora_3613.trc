  ObjectName:  Name=declare 
 FUNCTION ifelse (bool_in IN varchar2) 
   RETURN boolean 
 IS 
 BEGIN 
   IF bool_in = 'OFF' 
   THEN 
     RETURN false; 
  ELSE 
     RETURN true; 
  END IF;
  END; 
